{
    "name": "mzur/laravel-openstack-swift",
    "description": "OpenStack Swift storage driver for Laravel/Lumen.",
    "type": "library",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dit-werkt/laravel-cached-openstack.git"
        }
    ],
    "require": {
        "php": "^8.0",
        "nimbusoft/flysystem-openstack-swift": "^1.0",
        "biigle/laravel-cached-openstack": "dev-JA/php-8_5-support",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^9.0|^10.0|^11.0|^12.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Martin Zurowietz",
            "email": "martin@zurowietz.de"
        }
    ],
    "autoload": {
        "psr-4": {
            "Mzur\\Filesystem\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mzur\\Filesystem\\SwiftServiceProvider"
            ]
        }
    },
    "require-dev": {
        "vimeo/psalm": "^4.12|^6.0"
    }
}
